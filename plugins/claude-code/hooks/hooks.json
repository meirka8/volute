{
  "description": "CVC: records Claude Code sessions started in a repository where CVC is initialized and capture is acknowledged; elsewhere the hooks record nothing. Requires cvc 0.7.1 or later on PATH.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/check-cvc.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cvc ingest claude-code --hook",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cvc ingest claude-code --hook",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cvc ingest claude-code --hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
